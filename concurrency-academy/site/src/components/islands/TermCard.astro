---
// 名词卡：课内可折叠词条。与全局词典内容联动（后续接入 glossary 集合）。
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<div class="my-4 rounded-xl border border-stone-200 bg-white p-4 not-prose">
  <p class="text-xs font-bold text-teal-700">名词速查</p>
  <div class="mt-2 space-y-2">
    {items.map(([term, def]) => (
      <details class="rounded-lg bg-stone-50 p-3 text-sm">
        <summary class="cursor-pointer select-none font-semibold text-stone-800">{term}</summary>
        <p class="mt-1.5 leading-7 text-stone-600">{def}</p>
      </details>
    ))}
  </div>
</div>
