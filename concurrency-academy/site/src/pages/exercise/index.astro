---
import Base from '../../layouts/Base.astro';
import { readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

// 判题包是目前唯一事实源：public/exercises/<id>/。构建时读盘聚合（数据不在 content 集合内）。
const root = join(process.cwd(), 'public', 'exercises');
let packs: { id: string; title: string; difficulty: string; module: string; mission: string }[] = [];
try {
  packs = readdirSync(root, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => {
      try {
        const m = JSON.parse(readFileSync(join(root, d.name, 'manifest.json'), 'utf8'));
        return { id: m.id, title: m.title, difficulty: m.difficulty, module: m.module, mission: m.mission.slice(0, 60) };
      } catch {
        return null;
      }
    })
    .filter((x): x is NonNullable<typeof x> => x !== null)
    .sort((a, b) => a.module.localeCompare(b.module));
} catch {
  packs = [];
}
---
<Base title="判题练习" description="浏览器内真实 JDK 21 编译判题。">
  <div class="py-10">
    <h1 class="font-display text-3xl">判题练习</h1>
    <p class="mt-2 text-sm text-stone-500">全是真 JVM 判题，不是对答案。</p>
    {packs.length === 0 ? (
      <p class="mt-8 rounded-xl border border-dashed border-stone-300 p-8 text-center text-sm text-stone-400">
        首批练习随 M00–M01 内容批次上线。
      </p>
    ) : (
      <ul class="mt-8 space-y-2">
        {packs.map((p) => (
          <li class="flex flex-wrap items-baseline gap-3 rounded-xl border border-stone-200 bg-white p-4 text-sm">
            <span class="font-semibold text-stone-800">{p.title}</span>
            <span class="font-mono text-[11px] text-stone-400">{p.id}</span>
            <span class="ml-auto text-xs text-stone-400">{p.module} · {p.difficulty}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
