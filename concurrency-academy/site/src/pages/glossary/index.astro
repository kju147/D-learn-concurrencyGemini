---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const terms = await getCollection('glossary');
terms.sort((a, b) => a.data.term.localeCompare(b.data.term, 'zh'));
---
<Base title="名词词典" description="并发编程术语速查，每条可锚链引用。">
  <div class="py-10">
    <h1 class="font-display text-3xl">名词词典</h1>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {terms.length === 0 && (
        <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-sm text-stone-400">
          词条随课程批次补充。
        </p>
      )}
      {terms.map((t) => (
        <div id={t.slug} class="rounded-xl border border-stone-200 bg-white p-4">
          <p class="font-semibold text-stone-800">{t.data.term}</p>
          <p class="mt-1 text-xs leading-6 text-stone-500">{t.data.concise}</p>
        </div>
      ))}
    </div>
  </div>
</Base>
