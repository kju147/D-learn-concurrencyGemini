---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getModule, modules } from '../../../lib/curriculum';

export async function getStaticPaths() {
  return modules.map((m) => ({ params: { module: m.id }, props: { mod: m } }));
}

const { mod } = Astro.props;
const lessons = (await getCollection('lessons', ({ data }) => !data.draft && data.module === mod.id))
  .sort((a, b) => a.data.order - b.data.order);
const levels = await getCollection('levels', ({ data }) => data.module === mod.id);
---
<Base title={`${mod.index} ${mod.title}`} description={mod.subtitle}>
  <div class="py-10">
    <p class="font-mono text-sm font-bold text-teal-700">{mod.index}</p>
    <h1 class="font-display mt-1 text-3xl">{mod.title}</h1>
    <p class="mt-2 text-sm text-stone-500">{mod.subtitle} · 毕业线：{mod.gate}</p>

    {levels.length === 0 && lessons.length === 0 ? (
      <p class="mt-8 rounded-xl border border-dashed border-stone-300 p-8 text-center text-sm text-stone-400">
        本模块内容生产中。
      </p>
    ) : (
      <ol class="mt-8 space-y-2">
        {levels.map((l, i) => (
          <li>
            <a href={`/level/${l.id}`}
               class="flex items-center gap-4 rounded-xl border border-teal-200 bg-teal-50/60 p-4 hover:border-teal-300 hover:shadow-sm">
              <span class="font-mono text-xs text-teal-700">关卡 {String(i + 1).padStart(2, '0')}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-stone-800">{l.data.title}</span>
              </span>
              <span class="text-xs text-stone-400">{l.data.level} · {l.data.minutes}′</span>
            </a>
          </li>
        ))}
        {lessons.map((l) => (
          <li>
            <a href={`/learn/${mod.id}/${l.slug}`}
               class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-4 hover:border-teal-300 hover:shadow-sm">
              <span class="font-mono text-xs text-stone-400">{String(l.data.order).padStart(2, '0')}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-stone-800">{l.data.title}</span>
                <span class="block truncate text-xs text-stone-500">{l.data.subtitle}</span>
              </span>
              <span class="text-xs text-stone-400">{l.data.level} · {l.data.minutes}′</span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
