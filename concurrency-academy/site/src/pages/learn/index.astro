---
// 课程地图：14 模块 + 每模块的课列表（从内容集合实时聚合）
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { modules } from '../../lib/curriculum';

const lessons = await getCollection('lessons', ({ data }) => !data.draft);
const levels = await getCollection('levels');
const byModule = new Map(modules.map((m) => [m.id, [] as typeof lessons]));
for (const l of lessons) byModule.get(l.data.module)?.push(l);
for (const list of byModule.values()) list.sort((a, b) => a.data.order - b.data.order);
const levelsByModule = new Map(modules.map((m) => [m.id, [] as typeof levels]));
for (const l of levels) levelsByModule.get(l.data.module)?.push(l);
---
<Base title="课程地图" description="从并发直觉到生产实战的完整路线，基线 JDK 21。">
  <div class="py-10">
    <h1 class="font-display text-3xl">课程地图</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-500">
      一张图走到底。每节课都是一个固定 URL，课上讲不通的地方可以在页底讨论区发问。
      初级走前 10 个模块，中级从 M04 开始，高级请直奔 M05 之后的原理与实战。
    </p>

    <div class="mt-8 space-y-4">
      {modules.map((m) => {
        const list = byModule.get(m.id) ?? [];
        return (
          <section class="rounded-xl border border-stone-200 bg-white p-5">
            <div class="flex flex-wrap items-baseline gap-3">
              <span class="font-mono text-sm font-bold text-teal-700">{m.index}</span>
              <h2 class="text-lg font-bold">{m.title}</h2>
              <span class="text-xs text-stone-500">{m.subtitle}</span>
              <span class="ml-auto text-xs text-stone-400">毕业线：{m.gate}</span>
            </div>
            {list.length === 0 && (levelsByModule.get(m.id)?.length ?? 0) === 0 ? (
              <p class="mt-3 text-xs text-stone-400">内容生产中…</p>
            ) : (
              <ol class="mt-3 space-y-1">
                {(levelsByModule.get(m.id) ?? []).map((l, i) => (
                  <li>
                    <a class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-stone-50" href={`/level/${l.id}`}>
                      <span class="font-mono text-[11px] text-teal-700">关卡 {String(i + 1).padStart(2, '0')}</span>
                      <span class="font-medium text-stone-800 group-hover:text-teal-700">{l.data.title}</span>
                      <span class="text-xs text-stone-400">{l.data.level}</span>
                      <span class="ml-auto text-[11px] text-stone-400">{l.data.minutes}′</span>
                    </a>
                  </li>
                ))}
                {list.map((l) => (
                  <li>
                    <a class="group flex items-center gap-3 rounded-lg px-3 py-2 text-sm hover:bg-stone-50" href={`/learn/${m.id}/${l.slug}`}>
                      <span class="font-mono text-[11px] text-stone-400">{m.index.replace('M', '')}.{l.data.order}</span>
                      <span class="font-medium text-stone-800 group-hover:text-teal-700">{l.data.title}</span>
                      <span class="text-xs text-stone-400">{l.data.subtitle}</span>
                      <span class="ml-auto text-[11px] text-stone-400">{l.data.minutes}′</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </section>
        );
      })}
    </div>
  </div>
</Base>
