BUILD_VERSION_JAVA_VARDEPS_old := /usr/bin/cat /usr/bin/sed -e 's|@@LAUNCHER_NAME@@|openjdk|g' -e 's|@@RUNTIME_NAME@@|OpenJDK Runtime Environment|g' -e 's|@@VERSION_SHORT@@|25-internal|g' -e 's|@@VERSION_STRING@@|25-internal-adhoc.root.openjdk|g' -e 's|@@VERSION_NUMBER@@|25|g' -e 's|@@VERSION_PRE@@|internal|g' -e 's|@@VERSION_BUILD@@||g' -e 's|@@VERSION_OPT@@|adhoc.root.openjdk|g' -e 's|@@VERSION_DATE@@|2025-09-16|g' -e 's|@@VERSION_CLASSFILE_MAJOR@@|69|g' -e 's|@@VERSION_CLASSFILE_MINOR@@|0|g' -e 's|@@VERSION_SPECIFICATION@@|25|g' -e 's|@@VENDOR_VERSION_STRING@@||g' -e 's|@@VENDOR@@|N/A|g' -e 's|@@VENDOR_URL@@|https://openjdk.org/|g' -e 's|@@VENDOR_URL_BUG@@|https://bugreport.java.com/bugreport/|g' -e 's|@@VENDOR_URL_VM_BUG@@|https://bugreport.java.com/bugreport/crash.jsp|g'
