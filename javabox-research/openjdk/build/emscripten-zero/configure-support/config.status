S["DEFS"]="-DPACKAGE_NAME=\\\"OpenJDK\\\" -DPACKAGE_TARNAME=\\\"openjdk\\\" -DPACKAGE_VERSION=\\\"openjdk\\\" -DPACKAGE_STRING=\\\"OpenJDK\\ openjdk\\\" -DPACKAGE_BUGREPORT=\\\"b"\
"uild-dev@openjdk.org\\\" -DPACKAGE_URL=\\\"https://openjdk.org\\\" -DHAVE_STDIO_H=1 -DHAVE_STDLIB_H=1 -DHAVE_STRING_H=1 -DHAVE_INTTYPES_H=1 -DHAVE_STDINT_"\
"H=1 -DHAVE_STRINGS_H=1 -DHAVE_SYS_STAT_H=1 -DHAVE_SYS_TYPES_H=1 -DHAVE_UNISTD_H=1 -DSTDC_HEADERS=1 -DHAVE_STDIO_H=1 -DSIZEOF_INT_P=4 -DHAVE_LIBM=1 -"\
"DHAVE_LIBDL=1"
