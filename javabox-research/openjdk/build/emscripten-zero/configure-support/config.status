"s/jdk1.8/bin:/mnt/c/Program Files/Pandoc/:/mnt/c/Program Files/dotnet/:/mnt/d/apps/nodejs/:/mnt/c/Users/69417/AppData/Local/Microsoft/WindowsApps:/m"\
